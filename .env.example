# App
APP_IMAGE=
APP_NAME=AnimeThemes
APP_URL=http://animethemes-rust.test
APP_PORT=
APP_KEY=
APP_LOCAL_IPS=

CLIENT_URL=http://animethemes-rust.test:3000
LOCO_ENV=development
LOG_LEVEL=info
RUST_BACKTRACE=1

# Database
DATABASE_URL=mysql://root@mysql:3306/animethemes
DATABASE_LOGGING=false
DB_PORT=3306
DB_DATABASE=animethemes
DB_PASSWORD=

# Files
AUDIO_URL=https://a.animethemes.moe
SCRIPT_URL=https://script.animethemes.moe
VIDEO_URL=https://v.animethemes.moe

IMAGE_ACCESS_KEY_ID=
IMAGE_SECRET_ACCESS_KEY=
IMAGE_DEFAULT_REGION=
IMAGE_BUCKET=
IMAGE_ENDPOINT=
IMAGE_URL=

VIDEO_NYC_ACCESS_KEY_ID=
VIDEO_NYC_SECRET_ACCESS_KEY=
VIDEO_NYC_DEFAULT_REGION=
VIDEO_NYC_BUCKET=
VIDEO_NYC_ENDPOINT=
VIDEO_FRA_ACCESS_KEY_ID=
VIDEO_FRA_SECRET_ACCESS_KEY=
VIDEO_FRA_DEFAULT_REGION=
VIDEO_FRA_BUCKET=
VIDEO_FRA_ENDPOINT=

AUDIO_NYC_ACCESS_KEY_ID=
AUDIO_NYC_SECRET_ACCESS_KEY=
AUDIO_NYC_DEFAULT_REGION=
AUDIO_NYC_BUCKET=
AUDIO_NYC_ENDPOINT=
AUDIO_FRA_ACCESS_KEY_ID=
AUDIO_FRA_SECRET_ACCESS_KEY=
AUDIO_FRA_DEFAULT_REGION=
AUDIO_FRA_BUCKET=
AUDIO_FRA_ENDPOINT=

DUMP_ACCESS_KEY_ID=
DUMP_SECRET_ACCESS_KEY=
DUMP_DEFAULT_REGION=
DUMP_BUCKET=
DUMP_ENDPOINT=

SCRIPT_ACCESS_KEY_ID=
SCRIPT_SECRET_ACCESS_KEY=
SCRIPT_DEFAULT_REGION=
SCRIPT_BUCKET=
SCRIPT_ENDPOINT=

# File Configurations
AUDIO_URL=
AUDIO_PATH=/audio
AUDIO_NGINX_REDIRECT=/audio_redirect
VIDEO_URL=
VIDEO_PATH=/video
VIDEO_NGINX_REDIRECT=/video_redirect

# GraphQL
DATALOADER_DELAY_MS=1
DATALOADER_MAX_BATCH_SIZE=1000

# Hashids
HASHIDS_SALT=

# Mail
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAIL_MAILER=smtp
MAIL_HOST=mailpit-rs
MAIL_PORT=1025
MAIL_FROM_ADDRESS=admin@animethemes.moe
MAIL_FROM_NAME="${APP_NAME}"

# Playlist
USER_MAX_PLAYLISTS=1000
PLAYLIST_MAX_TRACKS=1000

# Rate Limiting
RATE_LIMIT=90
HOSTNAMES_BYPASS="next-build,next-server,beta-next-build,beta-next-server"

# Redis
REDIS_URL=redis://redis-rs:6379

# Services
DISCORD_BOT_TOKEN=
DISCORD_DB_UPDATES_CHANNEL_ID=
DISCORD_ADMIN_CHANNEL_ID=

# Session
SESSION_DOMAIN=.animethemes-rust.test

# Typesense
TYPESENSE_URL=http://typesense:8108
TYPESENSE_API_KEY=anysecretkeyhere
FORWARD_TYPESENSE_PORT=

# Client
CLIENT_PROFILE_URL="${CLIENT_URL}/profile"
CLIENT_RESET_PASSWORD_URL="${CLIENT_URL}/profile/reset-password?token="